prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["codex", "--help"], decision="allow")
prefix_rule(pattern=["codex", "debug", "--help"], decision="allow")
prefix_rule(pattern=["codex", "sandbox", "--help"], decision="allow")
prefix_rule(pattern=["codex", "sandbox", "linux", "--help"], decision="allow")
prefix_rule(pattern=["codex", "sandbox", "linux"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Publishing remote Git state requires current user approval")
prefix_rule(pattern=["git", "send-pack"], decision="prompt", justification="Publishing remote Git state requires current user approval")
prefix_rule(pattern=["gh", "pr", "merge"], decision="prompt", justification="Merging a pull request requires current user approval")
