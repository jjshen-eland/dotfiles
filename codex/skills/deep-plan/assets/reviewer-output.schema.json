{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "verified_claims",
    "unverified_claims",
    "recommendation"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "layer", "severity", "evidence"],
        "properties": {
          "issue": {"type": "string", "minLength": 1},
          "layer": {"enum": ["verifiable", "judgment"]},
          "severity": {"enum": ["blocker", "high", "medium", "low"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "verified_claims": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unverified_claims": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommendation": {"enum": ["start", "do_not_start"]}
  }
}
